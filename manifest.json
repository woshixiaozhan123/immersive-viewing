{
  "manifest_version": 3,
  "name": "实时美颜",
  "version": "1.1.0",
  "description": "本机离线实时网页视频美颜扩展（MV3 悬浮球模式 + WebGL + MediaPipe 478 点人脸追踪），支持 26 项 Wink/剪映专业美肤、美型、美妆与画面调色、7 档预设与 Wink 中文配方解析。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "实时美颜（点击展开/收起悬浮面板）",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.missav.ws/*",
        "https://missav.ws/*",
        "https://*.missav.com/*",
        "https://missav.com/*",
        "https://*.javrate.com/*",
        "https://javrate.com/*",
        "https://*.avbebe.com/*",
        "https://avbebe.com/*"
      ],
      "js": [
        "content/grab-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://*.missav.ws/*",
        "https://missav.ws/*",
        "https://*.missav.com/*",
        "https://missav.com/*",
        "https://*.javrate.com/*",
        "https://javrate.com/*",
        "https://*.avbebe.com/*",
        "https://avbebe.com/*"
      ],
      "js": [
        "content/grab-relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://*.bilibili.com/*",
        "https://*.youtube.com/*"
      ],
      "js": [
        "content/cache-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.bilibili.com/*",
        "https://*.youtube.com/*"
      ],
      "js": [
        "content/cache-relay.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/engine.js",
        "content/overlay-ui.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "worker/face-worker.js",
        "vendor/mediapipe/*",
        "vendor/mediapipe/wasm/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
