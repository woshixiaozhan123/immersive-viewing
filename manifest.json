{
  "manifest_version": 3,
  "name": "沉浸式观影",
  "version": "1.2.0",
  "description": "沉浸式观影 — 本机离线网页视频增强扩展，集 26 项 WebGL + MediaPipe 478 点实时美颜、本地 AI 离线中文字幕翻译、透明视频缓存与自制播放器控制条于一体。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "沉浸式观影（点击展开/收起悬浮面板）",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/grab-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/grab-relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://*.bilibili.com/*",
        "https://*.youtube.com/*"
      ],
      "js": [
        "content/cache-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.bilibili.com/*",
        "https://*.youtube.com/*"
      ],
      "js": [
        "content/cache-relay.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/player-bar.js",
        "content/subtitles.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/engine.js",
        "content/overlay-ui.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "worker/face-worker.js",
        "vendor/mediapipe/*",
        "vendor/mediapipe/wasm/*",
        "worker/hair-worker.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
